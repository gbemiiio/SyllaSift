# Copy this file to .streamlit/secrets.toml for local development.
# Never commit the real client secret or cookie secret.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "replace-with-your-google-oauth-client-id"
client_secret = "replace-with-your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
